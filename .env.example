# --- Flask -----------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ----------------------------------------------------------
# If left unset, the app falls back to a local SQLite database
# (instance/campusshare.db) so it can run without any setup.
#
# To use MySQL instead, uncomment and edit the line below:
# DATABASE_URL=mysql+pymysql://campusshare_user:your_password@localhost/campusshare

# --- College restriction ------------------------------------------------
COLLEGE_EMAIL_DOMAIN=mycollege.edu
